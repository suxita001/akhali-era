rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['admin@example.com'];
    }
    function isAdmin() {
      return isOwner() || (request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function capOf(campId) { return get(/databases/$(database)/documents/camps/$(campId)).data.get('capacity', 0); }
    function seatsNow(campId) { return get(/databases/$(database)/documents/stats/$(campId)).data.taken; }
    function seatsAfter(campId) { return getAfter(/databases/$(database)/documents/stats/$(campId)).data.taken; }

    match /site/{doc}     { allow read: if true; allow write: if isAdmin(); }
    match /camps/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /faq/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /people/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /reviews/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /admins/{email} { allow read: if isAdmin(); allow write: if isOwner(); }

    // seat counter per camp: a participant may add exactly 1, together with their own new booking
    match /stats/{campId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['taken'])
        && request.resource.data.taken == resource.data.taken + 1
        && !exists(/databases/$(database)/documents/bookings/$(campId + '__' + myEmail()))
        && existsAfter(/databases/$(database)/documents/bookings/$(campId + '__' + myEmail()));
    }

    // page-view counter (no personal data)
    match /visits/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['d', 'p', 's', 'm', 't'])
        && request.resource.data.d is string && request.resource.data.d.size() == 10
        && request.resource.data.p is string && request.resource.data.p.size() <= 20
        && request.resource.data.s is string && request.resource.data.s.size() <= 30
        && request.resource.data.m in [0, 1]
        && request.resource.data.t == request.time;
    }

    match /bookings/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.email == myEmail()
        && id == request.resource.data.campId + '__' + myEmail()
        && exists(/databases/$(database)/documents/camps/$(request.resource.data.campId))
        && get(/databases/$(database)/documents/camps/$(request.resource.data.campId)).data.status == 'open'
        && ((request.resource.data.status == 'new'
              && (capOf(request.resource.data.campId) == 0 || seatsNow(request.resource.data.campId) < capOf(request.resource.data.campId))
              && seatsAfter(request.resource.data.campId) == seatsNow(request.resource.data.campId) + 1)
          || (request.resource.data.status == 'waitlist'
              && capOf(request.resource.data.campId) > 0
              && seatsNow(request.resource.data.campId) >= capOf(request.resource.data.campId)))
        && request.resource.data.keys().hasOnly(['campId','campTitle','name','age','birthDate','answers','phone','email','verifiedVia','parentName','parentPhone','notes','status','adminNote','createdAt'])
        && request.resource.data.verifiedVia in ['google', 'email']
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 30
        && request.resource.data.age is int && request.resource.data.age >= 5 && request.resource.data.age <= 99
        && request.resource.data.birthDate is string && request.resource.data.birthDate.size() == 10
        && request.resource.data.answers is list && request.resource.data.answers.size() <= 30
        && request.resource.data.campId is string && request.resource.data.campId.size() <= 80
        && request.resource.data.campTitle is string && request.resource.data.campTitle.size() <= 200
        && request.resource.data.parentName is string && request.resource.data.parentName.size() <= 120
        && request.resource.data.parentPhone is string && request.resource.data.parentPhone.size() <= 30
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1500
        && request.resource.data.adminNote == ''
        && request.resource.data.createdAt == request.time;
    }
  }
}
