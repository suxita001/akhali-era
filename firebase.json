{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "README.md", "**/.*"],
    "headers": [
      { "source": "**/*.@(css|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
